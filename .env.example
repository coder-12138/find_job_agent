# ============================================================
# OpenAI API 配置
# ============================================================
# LLM API 配置（OpenAI 兼容格式）
LLM_API_KEY=sk-uemeswmekkqmedzuglehjrkjrmewtoqkrpbayifmzqilodiw
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_NAME=Pro/zai-org/GLM-5.1

# Embedding 配置（API_KEY、BASE_URL可与 LLM 不同）
# EMBEDDING_API_KEY=sk-uemeswmekkqmedzuglehjrkjrmewtoqkrpbayifmzqilodiw
# EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=Qwen/Qwen3-VL-Embedding-8B
# 单次 embedding 请求最多条数（SiliconFlow 等为 64；纯 OpenAI 可尝试 100）
EMBEDDING_BATCH_SIZE=64

# ============================================================
# 邮件通知配置（可选）
# ============================================================
# 是否启用邮件通知 (true/false)
EMAIL_NOTIFICATION_ENABLED=false

# SMTP 服务器配置
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# 发件人邮箱（需开启 SMTP 服务）
SMTP_SENDER_EMAIL=your-email@gmail.com
# 发件人邮箱密码或应用专用密码
SMTP_SENDER_PASSWORD=your-app-password

# 收件人邮箱（接收通知的邮箱）
SMTP_RECIPIENT_EMAIL=recipient@example.com

# ============================================================
# 用户信息文件路径
# ============================================================
# 个人信息文件路径（支持 .json, .txt, .md）
# 默认自动查找项目根目录下 data/personal_information.txt
# PERSONAL_INFO_FILE_PATH=./data/personal_information.txt

# 简历PDF文件路径
# 默认自动查找项目根目录下 resume_personal_info/ 目录中的第一个PDF文件
# RESUME_FILE_PATH=./resume_personal_info/你的简历.pdf

# ============================================================
# 浏览器配置
# ============================================================
# 是否使用无头模式 (true/false)
# Windows 桌面环境建议设为 false，Linux 服务器建议设为 true
BROWSER_HEADLESS=true
# 浏览器超时时间（毫秒）
BROWSER_TIMEOUT=30000
